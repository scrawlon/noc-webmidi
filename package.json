{
  "name": "noc-webmidi",
  "version": "0.0.3",
  "description": "noc-webmidi.js -- Novation Circuit&trade; JavaScript Midi library",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:browser && npm run build:node",
    "build:browser": "esbuild src/js/noc-webmidi.js --bundle --minify --sourcemap --outfile=dist/js/noc-webmidi.min.js --format=iife --global-name=circuitMidiApp",
    "build:node": "esbuild src/js/index.js --bundle --minify --sourcemap --outfile=lib/index.js --format=cjs --platform=node",
    "watch": "esbuild src/js/noc-webmidi.js --bundle --sourcemap --outfile=dist/js/noc-webmidi.min.js --format=iife --global-name=circuitMidiApp --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrawlon/noc-webmidi.git"
  },
  "keywords": [
    "novation",
    "circuit",
    "midi"
  ],
  "author": "Scott McGrath (scrawlon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scrawlon/noc-webmidi/issues"
  },
  "homepage": "https://github.com/scrawlon/noc-webmidi",
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
